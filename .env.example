# NexTap Core local Next.js app. Supabase is the current source until the migration cutover.
NEXTAP_ENV=development
NEXTAP_BUILD_DIR=.next
NEXTAP_ALLOW_DYNAMIC_PUBLIC_ORIGIN=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_WALLET_USSD_ENABLED=true

# Current source database; keep on the approved Staging project during migration work.
NEXT_PUBLIC_SUPABASE_URL=https://flkakuysakgwfoemgbwn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_staging_key

# Optional Sentry runtime/build settings. Tokens stay local or in CI secrets.
SENTRY_ENABLED=1
NEXT_PUBLIC_SENTRY_ENABLED=1
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=abdelrahman-0n
SENTRY_PROJECT=nextap
SENTRY_URL=
SENTRY_TEST_ERRORS_ENABLED=0

# Test-only values. Use disposable local/QA users and fixtures, never production identities.
E2E_SERVER_MODE=0
E2E_BASE_URL=http://127.0.0.1:3137
E2E_USER_OWNER_USERNAME=
E2E_USER_OWNER_PASSWORD=
E2E_USER_NON_OWNER_USERNAME=
E2E_USER_NON_OWNER_PASSWORD=
E2E_ALLOW_MUTATIONS=0
E2E_FIXTURE_PATH=
E2E_FIXTURE_JSON=
E2E_CONTACT_BUSINESS_ID=
E2E_CONTACT_MAIN_PAGE_ID=
E2E_CONTACT_BRANCH_PAGE_ID=
E2E_KEEP_RELIABILITY_FIXTURE=0
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional local audit scripts; leave blank to use their documented defaults.
AUDIT_FIXTURE_PATH=
AUDIT_LIGHTHOUSE_MODULE=
OPTIMIZATION_BASE_URL=http://127.0.0.1:3140
RELIABILITY_BASE_URL=http://127.0.0.1:3138

# Approved development/staging project. Production is blocked in local dev and E2E.
NEXTAP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://flkakuysakgwfoemgbwn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Public origin used in generated QR/NFC card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public contact number (international digits, no plus sign)
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Sentry runtime DSNs are public identifiers, but keep them environment-specific.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_ENABLED=1
# Set only in a safe local/staging session to expose the controlled test routes.
SENTRY_TEST_ERRORS_ENABLED=0
# Build-time only; never expose this token to the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=abdelrahman-0n
SENTRY_PROJECT=nextap

{
  "name": "nextap-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "e2e run",
    "test:e2e:hosted": "e2e run --config e2e.hosted.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/database/test-database.mjs",
    "test:e2e:seed": "node scripts/database/seed-e2e.mjs",
    "check:file-budgets": "node scripts/ci/check-file-budgets.mjs",
    "check:knip": "knip --reporter compact --no-exit-code",
    "check:dependency-status": "node scripts/ci/dependency-status.mjs",
    "test:mutation:publication": "stryker run stryker.config.mjs",
    "test:mutation:card-inventory": "stryker run stryker.card-inventory.config.mjs",
    "continuity:validate": "node scripts/continuity/continuation.mjs validate",
    "continuity:restore": "node scripts/continuity/continuation.mjs restore compact",
    "test:watch": "vitest",
    "test:db:concurrency": "node scripts/database/test-concurrency.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.100.1",
    "fflate": "^0.8.3",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "3.3.7",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "e2e": "0.18.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.28",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "jsqr": "^1.4.0",
    "knip": "6.44.1",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.2",
    "vcard-parser": "1.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.29",
    "vite": "7.3.7",
    "zod": "$zod"
  }
}

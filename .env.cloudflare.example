# Cloudflare CLI/CI provisioning and deployment only. Never pass this file to the browser.
# Set real values in the local process environment or CI secret store; do not commit filled copies.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Used only if an application endpoint validates Cloudflare Access JWTs.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

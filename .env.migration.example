# Migration tooling only. Copy to .env.migration.local; never load this into Next.js.
# Cloudflare API token/account/zone values are kept separately in .env.cloudflare.local.

# Supabase projects recorded in the current repository configuration.
SUPABASE_PROJECT_REF_STAGING=flkakuysakgwfoemgbwn
SUPABASE_PROJECT_REF_PRODUCTION=jezpobjlfvihikplxrta

# Scoped Supabase Management API token; read-only project settings/API key access.
SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection strings copied from each project's Dashboard > Connect.
# Prefer a read-only database role. These strings contain database credentials.
SUPABASE_DB_URL_STAGING=
SUPABASE_DB_URL_PRODUCTION=

# Required to migrate the private business-media Storage bucket; server-only.
# These bypass RLS. Never load them into Next.js or expose them to a browser.
SUPABASE_SECRET_KEY_STAGING=
SUPABASE_SECRET_KEY_PRODUCTION=

# Optional only if a later CLI/CI action needs a separate Vercel API token.
# Vercel project inspection currently works through the connected MCP.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional only if GitHub Actions credentials must be configured by API.
# Local GitHub CLI authentication is already available.
GITHUB_TOKEN=

# Generated by the staging Cloudflare Access application after its hostname is routed.
CLOUDFLARE_ACCESS_AUD=

# Hostinger API token for authorized DNS record operations; never change apex nameservers during Phase 0.
# Keep the token limited to domain/DNS permissions if hPanel offers that choice.
HOSTINGER_API_TOKEN=

{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/continuity/hook.mjs --platform claude",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/continuity/hook.mjs --platform claude",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
